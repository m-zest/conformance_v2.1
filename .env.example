# Conformance configuration.
# Copy to .env and adjust. Every value is optional: without a .env file the
# stack starts in demo mode against the bundled simulator.

# ---------------------------------------------------------------- access
# Dashboard administrator created on first start. Change the password before
# anyone else can reach the dashboard. It can also be changed under Settings.
ADMIN_EMAIL=admin@meridian.example
ADMIN_PASSWORD=ChangeMe-Pilot-2026

# Secret used to sign dashboard sessions and to fingerprint sensitive values.
# If empty, one is generated on first start and kept in the data volume.
SECRET_KEY=

# Set to true when the dashboard is served over HTTPS.
COOKIE_SECURE=false

# Database password for the bundled Postgres.
POSTGRES_PASSWORD=conformance-local-only

# ---------------------------------------------------------------- network
# Address the published ports bind to. Use 127.0.0.1 when a reverse proxy on
# the same host terminates TLS.
BIND_ADDRESS=0.0.0.0
GATEWAY_PORT=8000
DASHBOARD_PORT=8080
DEMO_APP_PORT=8090
SIMULATOR_PORT=9000

# URLs as users see them. Used in notification links and connection snippets.
DASHBOARD_URL=http://localhost:8080
GATEWAY_PUBLIC_URL=http://localhost:8000

# ---------------------------------------------------------------- model providers
# Where the gateway forwards requests. Leave unset to use the simulator.
#
# OpenAI:        OPENAI_BASE_URL=https://api.openai.com/v1
# Azure OpenAI:  OPENAI_BASE_URL=https://<resource>.openai.azure.com/openai/v1
#                OPENAI_AUTH_STYLE=api-key
# Self-hosted:   OPENAI_BASE_URL=http://vllm.internal:8000/v1
# Anthropic:     ANTHROPIC_BASE_URL=https://api.anthropic.com
#
# The provider keys live only here. Tools and users receive gateway keys.
#OPENAI_BASE_URL=
#OPENAI_API_KEY=
#OPENAI_AUTH_STYLE=bearer
#ANTHROPIC_BASE_URL=
#ANTHROPIC_API_KEY=

# ---------------------------------------------------------------- demo content
# DEMO_MODE registers the sample tools and the sample application key.
# DEMO_SEED loads two weeks of synthetic activity on first start.
# Set both to false for a clean pilot installation.
DEMO_MODE=true
DEMO_SEED=true
DEMO_APP_KEY=gw_demo_internal_assistant_local_only

# ---------------------------------------------------------------- detection
# Named entity detection (people, locations). Requires INSTALL_NER=true at build time.
INSTALL_NER=true
NER_ENABLED=true
#NER_ENTITIES=PERSON,LOCATION

# Guard model (Llama Guard). Start it with: docker compose --profile guard up -d
GUARD_LLM_ENABLED=false
#GUARD_LLM_MODEL=llama-guard3:1b
#GUARD_LLM_MODE=async        # async: classify without adding latency. inline: wait for the verdict.
#GUARD_LLM_BACKEND=ollama    # or openai for vLLM and other OpenAI-compatible servers
#GUARD_LLM_URL=http://ollama:11434

# ---------------------------------------------------------------- privacy
# redacted: store prompts with sensitive values replaced by placeholders (default)
# none:     store no prompt or response text, metadata and findings only
# full:     store original text. Check with your privacy officer first.
STORE_PROMPTS=redacted
STORE_RESPONSES=true
STORE_FINDING_PREVIEWS=true
RETENTION_DAYS=180

# ---------------------------------------------------------------- notifications
# Alerts of this severity and above are sent to every configured channel.
NOTIFY_MIN_SEVERITY=high
#SLACK_WEBHOOK_URL=
#TEAMS_WEBHOOK_URL=
# Generic JSON webhook for a SIEM or ticketing system. Unset, it points at the
# simulator so you can watch deliveries. Set it empty to disable.
#ALERT_WEBHOOK_URL=
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASSWORD=
#SMTP_FROM=
#SMTP_TO=security@example.com,privacy@example.com

# ---------------------------------------------------------------- single sign-on for developer tools
# When set, the gateway also accepts OIDC tokens from your identity provider.
#OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
#OIDC_AUDIENCE=api://conformance-gateway
#OIDC_EMAIL_CLAIM=email
#OIDC_TEAM_CLAIM=department
#OIDC_DEFAULT_APP=developer-tools

# ---------------------------------------------------------------- Copilot connectors
# disabled | demo (bundled simulator) | live
M365_COPILOT_MODE=demo
#M365_TENANT_ID=
#M365_CLIENT_ID=
#M365_CLIENT_SECRET=

GITHUB_COPILOT_MODE=demo
#GITHUB_ORG=
#GITHUB_TOKEN=
#GITHUB_API_URL=https://api.github.com
#GITHUB_API_VERSION=2026-03-10

CONNECTOR_POLL_SECONDS=300
